# Copy to .env and fill in. Never commit .env.
# Public key shipped in resy.com's web client bundle (see README for how to find it).
RESY_API_KEY=

# Scheduler: minutes between automatic runs (0 = off), party sizes for scheduled runs
RUN_INTERVAL_MINUTES=60
RUN_ON_START=false
SCHEDULE_PARTY_SIZES=[2]
